rules_version = '2';

// Sicherheitsregeln für Pling (Firebase Console → Firestore → Regeln → einfügen → Veröffentlichen)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Profile: jeder angemeldete Nutzer darf Profile lesen (zum Freunde-Finden).
    // Ändern darf man nur sein eigenes Profil – andere dürfen nur sich selbst
    // in die Freundesliste eintragen oder daraus entfernen.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (
        request.auth.uid == userId ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendIDs']) &&
          request.resource.data.friendIDs.toSet().difference(resource.data.friendIDs.toSet()).hasOnly([request.auth.uid]) &&
          resource.data.friendIDs.toSet().difference(request.resource.data.friendIDs.toSet()).hasOnly([request.auth.uid])
        )
      );
    }

    // Chats: nur Mitglieder dürfen lesen und schreiben.
    match /conversations/{conversationId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.participantIDs);
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIDs;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIDs;

      match /messages/{messageId} {
        function isMember() {
          return request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIDs;
        }
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember() && request.resource.data.senderID == request.auth.uid;
        allow update: if signedIn() && isMember();
        allow delete: if signedIn() && resource.data.senderID == request.auth.uid;
      }
    }

    // Stories: lesen dürfen alle Angemeldeten, posten/löschen nur der Autor.
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorID == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.authorID == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
      );
      allow delete: if signedIn() && resource.data.authorID == request.auth.uid;
    }
  }
}
