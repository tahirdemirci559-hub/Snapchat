rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
         request.resource.data.friends.toSet().difference(resource.data.friends.toSet()).hasOnly([request.auth.uid])));
    }

    match /chats/{chatId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        function member() {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read, update: if signedIn() && member();
        allow create: if signedIn() && member() && request.resource.data.by == request.auth.uid;
        allow delete: if signedIn() && resource.data.by == request.auth.uid;
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']);
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }
    match /calls/{callId} {
      allow read: if signedIn() && (resource == null || request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update: if signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      match /cands/{candId} {
        function inCall() {
          let d = get(/databases/$(database)/documents/calls/$(callId)).data;
          return request.auth.uid == d.from || request.auth.uid == d.to;
        }
        allow read: if signedIn() && inCall();
        allow create: if signedIn() && inCall() && request.resource.data.by == request.auth.uid;
      }
    }
  }
}
